# Derived artefacts, regenerable from the scripts in this repo.
# cache/ is 2.7 GB (street embeddings + map token grids) and checkpoints/ is
# 975 MB; both are rebuilt by scripts/embed_street.py, scripts/fetch_tiles.py,
# scripts/build_knn.py and src/train.py.
cache/
checkpoints/
experiments/

# data/processed/*.parquet IS tracked on purpose -- it is the benchmark of
# record. The split it carries (sequence, hash 09806e14e749) drifted out of
# sync with build_dataset.py once already, and version-controlling it is what
# makes that detectable. Raw OSV-5M is not ours to redistribute.
data/osv5m/
data/raw/

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/
.DS_Store

# Overnight run scratch: logs, done-markers, utilisation samples.
# runs/REPORT.md and runs/state.json are the outputs worth keeping.
runs/logs/
runs/marks/
runs/util.csv
runs/*.out
runs/*.err
runs/*.log

# Cached per-image error arrays: derived, and regenerated by scripts/bootstrap.py
runs/errs/
runs/errs_firstn/
runs/state.json

# bank_ext*.parquet are 43 MB each and are NOT the benchmark -- they are
# bank-only shard metadata that build_bank_ext.py regenerates in under a
# minute. dataset.parquet above is the thing worth tracking.
data/processed/*/bank_ext*.parquet

# Exported per-image error arrays and probe outputs. Derived: bootstrap.py and
# eval_highres.py --export regenerate them, and they are ~236 KB each with one
# per arm per protocol, so they accumulate faster than any of them is read.
# The BOOTSTRAP_*.md next to them ARE tracked -- those are the results of
# record; these are the arrays the results were computed from.
runs/*.npz
runs/errs_prebug/

# Atomic-write leftovers. safeio writes <name>.tmp<pid> and renames; a crash
# between the two leaves the temp behind, and pyramid_cache's grow path uses
# .grow.npy. Never worth committing, and easy to sweep up by accident.
*.tmp[0-9]*
*.grow.npy
*.part

# Tooling scratch.
.pytest_cache/
.claude/
*.partial.npy

# Session state, not project documentation. These are rewritten wholesale
# every session to survive a compaction, so they conflict on every branch
# that runs in parallel -- docs/STATE.md was the only conflicting file
# between PR #26 and main. They stay on disk; they do not belong in history.
docs/STATE.md
docs/NEXT.md
